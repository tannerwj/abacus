{
  "name": "@tjohnson/abacus",
  "version": "0.2.0",
  "description": "Plug-and-play quality gates for TypeScript projects: oxlint presets (type-aware), cyclomatic/ABC complexity budgets, and gzip bundle-size budgets. Presets for plain TypeScript, Cloudflare Workers, and Vite SPAs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tannerwj/abacus.git"
  },
  "bin": {
    "abacus": "./dist/cli.js"
  },
  "files": [
    "dist",
    "configs",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./configs/*": "./configs/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --maxWorkers=2 --minWorkers=1",
    "check": "pnpm build && tsc -p tsconfig.json --noEmit && pnpm test && node dist/cli.js check",
    "check:all": "pnpm build && tsc -p tsconfig.json --noEmit && pnpm test && node dist/cli.js check --all",
    "test:install": "node test/fresh-install.mjs"
  },
  "peerDependencies": {
    "oxfmt": ">=0.60.0",
    "oxlint": ">=1.80.0",
    "oxlint-tsgolint": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "oxfmt": "0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@b12k/gitleaks": "8.30.1-v.53",
    "@publint/pack": "^0.1.7",
    "dependency-cruiser": "^18.5.0",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "publint": "^0.3.25",
    "smol-toml": "1.9.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "types": "./dist/index.d.ts"
}
