{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "promise", "import"],
  "categories": { "correctness": "error", "suspicious": "warn", "perf": "warn" },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": ["error", { "ignoreVoid": true }],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "promise/catch-or-return": "off",
    "no-await-in-loop": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "oxc/no-map-spread": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],

    "complexity": ["error", { "max": 20 }],
    "max-depth": ["error", { "max": 4 }],
    "max-params": ["error", { "max": 6 }],
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["warn", { "max": 120, "skipBlankLines": true, "skipComments": true, "IIFEs": true }]
  },
  "overrides": [
    { "files": ["**/*.test.*", "**/test/**", "**/tests/**", "**/__tests__/**"], "plugins": ["vitest"], "rules": { "max-lines-per-function": "off", "complexity": "off", "no-useless-concat": "off" } },
    { "files": ["scripts/**"], "rules": { "no-console": "off" } }
  ]
}
