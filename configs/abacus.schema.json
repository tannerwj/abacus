{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "abacus.config.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "preset": {
      "enum": [
        "typescript",
        "cloudflare-worker",
        "vite-spa",
        "nextjs"
      ]
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source roots scanned for ABC scores"
    },
    "tsc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "default": ["tsconfig.json"],
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]+:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
          },
          "description": "Required local JSON compiler projects, each checked separately with --noEmit; no implicit reference builds"
        }
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regex strings; matching paths skipped by ABC"
    },
    "abc": {
      "type": "object",
      "properties": {
        "budget": {
          "type": "integer",
          "minimum": 1
        },
        "allow": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "max",
              "why"
            ],
            "properties": {
              "max": {
                "type": "integer"
              },
              "why": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    },
    "size": {
      "type": "object",
      "properties": {
        "budgets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "dir",
              "match",
              "max"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "dir": {
                "type": "string"
              },
              "match": {
                "type": "string"
              },
              "max": {
                "type": "integer"
              },
              "mode": {
                "enum": [
                  "sum",
                  "largest"
                ]
              },
              "allowEmpty": {
                "type": "boolean",
                "default": false,
                "description": "Explicitly allow zero matching assets for this optional budget"
              }
            }
          }
        },
        "worker": {
          "type": "object",
          "required": [
            "max"
          ],
          "properties": {
            "max": {
              "type": "integer"
            },
            "wranglerArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ratchet": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Snapshot file written by `abacus ratchet --write`"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "loc": {
              "type": "object",
              "required": [
                "roots"
              ],
              "properties": {
                "roots": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "slack": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "oxlintWarnings": {
              "type": "boolean"
            },
            "abcMax": {
              "type": "boolean"
            },
            "comments": {
              "type": "object",
              "required": [
                "roots"
              ],
              "properties": {
                "roots": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "max": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "properties": {
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "lint",
              "abc",
              "ratchet",
              "tsc",
              "deadcode",
              "secrets",
              "cycles",
              "dupes",
              "todos",
              "size"
            ]
          },
          "description": "Aggregate gates; defaults to lint, abc, ratchet. New source gates are opt-in; size runs after build."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclude"],
      "properties": {
        "exclude": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Regex strings for project-relative paths (directories end in /) left out of the source digest: tool state that changes while checks run, such as a local dev server's database. Never source."
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reports"],
      "properties": {
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "format", "profile", "required", "enforcement"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,159}$" },
              "path": { "type": "string", "minLength": 1 },
              "format": { "enum": ["vitest", "playwright", "contract", "pnpm-audit"] },
              "profile": { "enum": ["behavior", "authorization", "resilience", "performance", "dependencies"] },
              "required": { "type": "boolean" },
              "enforcement": { "enum": ["block", "warn", "observe"] },
              "environment": { "enum": ["isolated", "staging"] },
              "maxAgeHours": { "type": "number", "exclusiveMinimum": 0, "default": 24 },
              "maxSkipped": { "type": "integer", "minimum": 0, "default": 0 },
              "maxFlaky": { "type": "integer", "minimum": 0, "default": 0 },
              "assertions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,159}$" } },
              "budgets": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "unit", "max", "minSamples"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,159}$" },
                    "unit": { "enum": ["ms", "bytes", "count"] },
                    "max": { "type": "number", "minimum": 0 },
                    "minSamples": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            },
            "allOf": [
              { "if": { "properties": { "profile": { "enum": ["authorization", "resilience"] } } }, "then": { "required": ["assertions", "environment"], "properties": { "format": { "const": "contract" }, "assertions": { "minItems": 1 } } } },
              { "if": { "properties": { "profile": { "const": "performance" } } }, "then": { "required": ["budgets", "environment"], "properties": { "format": { "const": "contract" }, "budgets": { "minItems": 1 } } } },
              { "if": { "properties": { "profile": { "const": "dependencies" } } }, "then": { "properties": { "format": { "const": "pnpm-audit" } } } },
              { "if": { "properties": { "format": { "const": "pnpm-audit" } } }, "then": { "properties": { "profile": { "const": "dependencies" } } } }
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "pack"
      ],
      "additionalProperties": false,
      "properties": {
        "pack": {
          "type": "object",
          "required": [
            "version",
            "digest"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "export": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "oneOf": [
            {
              "required": [
                "path"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "export"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "package",
                "export"
              ],
              "not": {
                "required": [
                  "path"
                ]
              }
            }
          ]
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "ruleId",
              "subject",
              "owner",
              "reason",
              "expires"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "expires": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
