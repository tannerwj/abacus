{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/index.ts", "src/cli.ts", "src/knip-reporter.ts", "test/**/*.test.ts", "test/*.mjs", "docs/examples/*.mjs"],
  "project": ["src/**/*.ts", "test/**/*.{ts,mjs}", "docs/examples/*.mjs"],
  "ignore": ["dist/**", "test/fixtures/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["dependency-cruiser", "jscpd", "@arethetypeswrong/cli", "oxfmt", "oxlint", "oxlint-tsgolint"],
  "ignoreBinaries": ["wrangler"]
}
